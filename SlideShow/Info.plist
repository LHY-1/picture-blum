<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>相框</string>
	<key>CFBundleExecutable</key>
	<string>SlideShow</string>
	<key>CFBundleIdentifier</key>
	<string>com.yuan.slideshow</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>SlideShow</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>iPhoneOS</string>
	</array>

	<!-- 部署目标。改这里同时也要改 build_ipa.sh 里的 MIN_IOS -->
	<key>MinimumOSVersion</key>
	<string>14.0</string>

	<!-- iPhone=1, iPad=2。两个都要，老设备才能全屏运行 -->
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>

	<!-- 相册权限：iOS 14 必需，缺失会直接崩溃 -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>需要访问你的相册来播放幻灯片照片</string>

	<!-- 往系统相册里写入的权限（把上传的照片存进图库用）。
	     缺了它 performChanges 会直接失败，照片存不进去。 -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>把上传的照片存进系统相册，相框就能直接播放</string>

	<!-- 局域网权限：App 内要监听端口等别的设备来传照片。
	     iOS 14 起必须有这一项，否则系统会拒绝局域网设备连接，
	     而且第一次开启上传服务时不会弹授权框。 -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>需要局域网权限，才能让手机或电脑通过浏览器把照片传进相框</string>

	<!-- 让 App 的 Documents 出现在「文件」App 和 Finder 里。
	     照片可以直接拖进去，App 会自动收编进上传库（见 LocalPhotoStore）。 -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- 启动画面（iOS 14+ 用 UILaunchScreen，老式的 LaunchImage 已废弃） -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>

	<!-- 相框模式：禁用 Slide Over / 分屏，避免被手势划走 -->
	<key>UIRequiresFullScreen</key>
	<true/>

	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- 主屏图标（PNG 直接放 bundle 根目录，不经过 Assets.xcassets） -->
	<key>CFBundleIconFiles</key>
	<array>
		<string>Icon-152</string>
		<string>Icon-120</string>
		<string>Icon-76</string>
	</array>
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array>
				<string>Icon-152</string>
				<string>Icon-120</string>
				<string>Icon-76</string>
			</array>
			<key>UIPrerenderedIcon</key>
			<false/>
		</dict>
	</dict>

	<!-- 构建时由脚本填充，占位值不影响运行 -->
	<key>DTPlatformName</key>
	<string>iphoneos</string>
	<key>DTPlatformVersion</key>
	<string>26.2</string>
	<key>DTSDKName</key>
	<string>iphoneos26.2</string>
</dict>
</plist>
